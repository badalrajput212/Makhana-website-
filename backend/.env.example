# =============================================================================
# ROOTS 2 RETAILS — BULK ORDER CHATBOT API
# Environment Variables Example
# =============================================================================
# Copy this file to .env (in the /backend/ folder) and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Business Contact ──────────────────────────────────────────────────────────
BUSINESS_EMAIL=nayavayapar@gmail.com
WHATSAPP_NUMBER=916205846653

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
# Add your deployed domain here in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://127.0.0.1:5501,https://yourdomain.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Option A: Gmail with App Password (easiest for small volume)
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to Google Account → Security → 2-Step Verification → App Passwords
# 3. Create an App Password for "Mail" on "Other" device named "R2R Chatbot"
# 4. Use that 16-character password below (NOT your regular Gmail password)
SMTP_SERVICE=gmail
SMTP_USER=nayavayapar@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password-here

# Option B: Generic SMTP (uncomment and use instead of Option A)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# Option C: SendGrid (high volume, recommended for production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key-here

# ── Admin API Key (protect the /api/orders endpoint) ─────────────────────────
# Generate a strong random key: openssl rand -hex 32
ADMIN_KEY=change-this-to-a-long-random-string-in-production
